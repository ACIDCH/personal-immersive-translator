{
  "manifest_version": 3,
  "name": "多模态翻译 | Multimodal Translate",
  "short_name": "多模态翻译",
  "description": "Multimodal bilingual translation for webpages, subtitles, images and documents; BYOK AI models.",
  "version": "0.4.4",
  "minimum_chrome_version": "125",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "tabCapture",
    "webNavigation",
    "identity",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.cognitive.microsofttranslator.com/*",
    "https://translation.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://ligamejpnracymxfbbff.supabase.co/*",
    "https://api.mymemory.translated.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "双语翻译"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}

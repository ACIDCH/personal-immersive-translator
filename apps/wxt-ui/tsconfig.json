{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    ".wxt/wxt.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../shared-ui/**/*.d.ts",
    "../shared-ui/**/*.d.ts"
  ]
}
